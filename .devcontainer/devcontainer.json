{
    "name": "QuadControl",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "quadcontrol-dev",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-python.python",
                "ms-python.vscode-pylance",
